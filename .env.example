# ============================================================
# TripMate AI — Environment Configuration
# Copy this file to .env and fill in your actual values
# ============================================================

# --- Groq LLM (Optional if using Gemini) ---
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL_NAME=openai/gpt-oss-120b

# --- Google Gemini (Recommended for massive free tier limits) ---
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# --- Tavily Search ---
TAVILY_API_KEY=your_tavily_api_key_here

# --- AviationStack (Flight Data) ---
AVIATIONSTACK_API_KEY=your_aviationstack_api_key_here
AVIATIONSTACK_BASE_URL=http://api.aviationstack.com/v1

# --- Google Maps / Places (Optional) ---
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# --- PostgreSQL (Long-Term Memory) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=tripmate_db
POSTGRES_USER=tripmate_user
POSTGRES_PASSWORD=your_pw_here
POSTGRES_POOL_MIN=2
POSTGRES_POOL_MAX=10

# --- FastAPI App ---
APP_HOST=0.0.0.0
APP_PORT=8000
APP_ENV=development
APP_DEBUG=true
APP_TITLE=TripMate AI
APP_VERSION=1.0.0
APP_DESCRIPTION=LangGraph Multi-Agent Travel Planner

# --- LangGraph ---
LANGGRAPH_CHECKPOINT_TABLE=tripmate_checkpoints
RECURSION_LIMIT=25

# --- LangSmith Tracing ---
# Get your key at https://smith.langchain.com
LANGSMITH_ENABLED=false
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=tripmate-ai
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LangChain uses this var directly (same as LANGSMITH_ENABLED)
LANGCHAIN_TRACING_V2=false

# --- Rate Limiting ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PLAN_TRIP=10/minute
RATE_LIMIT_GLOBAL=100/minute

# --- CORS ---
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
